# Local Development Configuration
# Copy this file to .env for local development without Docker

# Database Configuration
# DB_ENGINE: postgres (default) or mysql
# Even for local development, connect to a remote database
DB_ENGINE=mysql
DB_HOST=your-mysql-host
DB_PORT=3306
DB_NAME=openrepowiki
DB_USER=your-username
DB_PASSWORD=your-password

# Django Configuration
DJANGO_SECRET_KEY=local-dev-secret-key-change-in-production
DEBUG=True

# GitHub Token for API access (optional but recommended to avoid rate limits)
GITHUB_TOKEN=

# LLM Configuration
# Supported providers: deepseek, openrouter, ollama
LLM_PROVIDER=deepseek
LLM_APIKEY=
LLM_MODELNAME=deepseek-chat

# Token Processing Configuration (optional - defaults provided)
# TOKEN_PROCESSING_CHARACTER_LIMIT=70000
# TOKEN_PROCESSING_MAX_RETRIES=3
# TOKEN_PROCESSING_REDUCE_CHAR_PER_RETRY=3000

# Note: CELERY_BROKER_URL is intentionally not set.
# Without Redis/Celery, repository processing will run synchronously.
# This may cause web requests to hang for large repositories,
# but is simpler for local development.

